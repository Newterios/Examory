# Do not just copy this file for real use: run `make dev-env` to generate
# strong random values. These placeholders only make `docker compose config`
# work in CI.
POSTGRES_PASSWORD=change-me-postgres
AUTH_DB_PASSWORD=change-me-auth-db
COURSES_DB_PASSWORD=change-me-courses-db
COURSES_INTERNAL_TOKEN=change-me-courses-token
INTEGRITY_DB_PASSWORD=change-me-integrity-db-password
FILES_S3_SECRET=change-me-files-s3-secret
INTEGRITY_S3_SECRET=change-me-integrity-s3-secret
FILES_DB_PASSWORD=change-me-files-db-password
FILES_INTERNAL_TOKEN=change-me-files-internal-token
ASSIGNMENTS_DB_PASSWORD=change-me-assignments-db-password
QUIZZES_DB_PASSWORD=change-me-quizzes-db
GRADING_DB_PASSWORD=change-me-grading-db
ANOMALY_DB_PASSWORD=change-me-anomaly-db
REDIS_PASSWORD=change-me-redis
MONGO_PASSWORD=change-me-mongo
MINIO_ROOT_PASSWORD=change-me-minio
# base64 of a 32-byte Ed25519 seed: openssl rand -base64 32
AUTH_JWT_SIGNING_KEY=
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@examory.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
QUIZZES_SIM_CLOCK=disabled
# SHA-256 of ml/service/model/model.pkl, written by `make anomaly-model`.
ANOMALY_MODEL_SHA256=
