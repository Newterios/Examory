{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://examory.dev/schemas/envelope.schema.json",
  "title": "Examory event envelope (events.md §1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "version", "occurred_at", "producer", "actor", "context", "payload"],
  "properties": {
    "event_id": { "$ref": "#/$defs/uuid_v7" },
    "event_type": { "type": "string", "pattern": "^[a-z]+(_[a-z]+)*\\.[a-z]+(_[a-z]+)*$", "maxLength": 64 },
    "version": { "type": "integer", "minimum": 1 },
    "occurred_at": { "$ref": "#/$defs/timestamp_ms" },
    "producer": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "role"],
      "properties": {
        "user_id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["student", "teacher", "admin", "system"] }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["course_id", "group_id", "session_id"],
      "properties": {
        "course_id": { "$ref": "#/$defs/nullable_id" },
        "group_id": { "$ref": "#/$defs/nullable_id" },
        "session_id": { "$ref": "#/$defs/nullable_id" }
      }
    },
    "payload": { "type": "object" }
  },
  "$defs": {
    "uuid_v7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "id": {
      "description": "Opaque identifier. Platform services emit lowercase UUIDv7; synthetic fixtures may use prefixed ids such as att_88.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "nullable_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "timestamp_ms": {
      "description": "RFC 3339 UTC with millisecond precision.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "non_negative_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
