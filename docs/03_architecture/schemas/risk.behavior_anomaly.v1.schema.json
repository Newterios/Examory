{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://examory.dev/schemas/risk.behavior_anomaly.v1.schema.json",
  "title": "risk.behavior_anomaly v1",
  "description": "events.md §4: shared risk.* payload with behavior_anomaly evidence. score is a relative risk ranking in [0, 1], not a probability. evidence.features may gain additional keys without a version bump (events.md §4), so features is open; its documented keys are typed.",
  "$ref": "envelope.schema.json",
  "properties": {
    "event_type": { "const": "risk.behavior_anomaly" },
    "version": { "const": 1 },
    "actor": {
      "properties": { "role": { "const": "system" } }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_id", "target_type", "target_id", "score", "level", "model", "explanation", "evidence"],
      "properties": {
        "risk_id": { "$ref": "envelope.schema.json#/$defs/id" },
        "target_type": { "const": "attempt" },
        "target_id": { "$ref": "envelope.schema.json#/$defs/id" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "level": { "enum": ["low", "medium", "high"] },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 64 },
            "version": { "type": "string", "minLength": 1, "maxLength": 32 }
          }
        },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["features"],
          "properties": {
            "features": {
              "type": "object",
              "maxProperties": 64,
              "required": ["mean_answer_time_ms", "z_score", "synchronous_with"],
              "properties": {
                "mean_answer_time_ms": { "type": "number", "minimum": 0 },
                "z_score": { "type": ["number", "null"] },
                "synchronous_with": {
                  "type": "array",
                  "maxItems": 500,
                  "uniqueItems": true,
                  "items": { "$ref": "envelope.schema.json#/$defs/id" }
                },
                "changes_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
                "per_question": {
                  "$comment": "E-07 proposal, pending review. Optional in v1.",
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 200,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["question_index", "first_answer_time_ms", "reference_median_ms", "reference_scope", "fast_threshold_ms", "is_fast", "answer_changed"],
                    "properties": {
                      "question_index": { "type": "integer", "minimum": 0, "maximum": 199 },
                      "first_answer_time_ms": { "$ref": "envelope.schema.json#/$defs/non_negative_ms" },
                      "reference_median_ms": { "type": ["number", "null"], "minimum": 0 },
                      "reference_scope": { "enum": ["item_train", "global_train", "item_quiz_history", "global_quiz_history", "unavailable"] },
                      "fast_threshold_ms": { "type": "number", "minimum": 0 },
                      "is_fast": { "type": "boolean" },
                      "answer_changed": { "type": "boolean" }
                    },
                    "if": { "properties": { "reference_scope": { "const": "unavailable" } } },
                    "then": { "properties": { "reference_median_ms": { "type": "null" } } },
                    "else": { "properties": { "reference_median_ms": { "type": "number" } } }
                  }
                }
              },
              "additionalProperties": { "type": ["number", "string", "boolean", "null", "array"] }
            }
          }
        }
      }
    }
  }
}
