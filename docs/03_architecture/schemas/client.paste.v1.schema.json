{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://examory.dev/schemas/client.paste.v1.schema.json",
  "title": "client.paste v1",
  "$ref": "envelope.schema.json",
  "properties": {
    "event_type": {
      "const": "client.paste"
    },
    "version": {
      "const": 1
    },
    "producer": {
      "const": "event-collector"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "chars"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "envelope.schema.json#/$defs/id"
        },
        "exam_session_id": {
          "$ref": "envelope.schema.json#/$defs/nullable_id"
        },
        "chars": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
