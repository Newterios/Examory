{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://examory.dev/schemas/risk.plagiarism.v1.schema.json",
  "$comment": "Proposal, pending review.",
  "$ref": "envelope.schema.json",
  "properties": {
    "event_type": {
      "const": "risk.plagiarism"
    },
    "version": {
      "const": 1
    },
    "producer": {
      "const": "integrity"
    },
    "actor": {
      "properties": {
        "role": {
          "const": "system"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_id",
        "target_type",
        "target_id",
        "score",
        "level",
        "model",
        "explanation",
        "evidence"
      ],
      "properties": {
        "risk_id": {
          "$ref": "envelope.schema.json#/$defs/id"
        },
        "target_type": {
          "const": "submission"
        },
        "target_id": {
          "$ref": "envelope.schema.json#/$defs/id"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "matches"
          ],
          "properties": {
            "matches": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "submission_id",
                  "similarity",
                  "overlap_spans"
                ],
                "properties": {
                  "submission_id": {
                    "$ref": "envelope.schema.json#/$defs/id"
                  },
                  "similarity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "overlap_spans": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "target",
                        "source",
                        "token_count"
                      ],
                      "properties": {
                        "target": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "source": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "token_count": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
